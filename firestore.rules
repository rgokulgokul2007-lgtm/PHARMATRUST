rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ========================================================================
    // PharmaTrust - Healthcare Clinical Security Rules
    // Collections: Medicines, Inventory, Users, AuditLogs, PharmaInventory
    // ========================================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    // Validation for Medicines document schema
    // Fields: medicineId, brandName, genericName, activeIngredients (array), strength, dosageForm, manufacturer
    function isValidMedicine(data) {
      return data.medicineId is string &&
             data.brandName is string && data.brandName.size() > 0 &&
             data.genericName is string &&
             data.activeIngredients is list && data.activeIngredients.size() > 0 &&
             data.strength is string &&
             data.dosageForm is string &&
             data.manufacturer is string;
    }

    // Validation for Inventory document schema
    // Fields: inventoryId, medicineId, branchId, batchNumber, quantity, expiryDate, updatedAt
    function isValidInventory(data) {
      return data.inventoryId is string &&
             data.medicineId is string &&
             data.branchId is string &&
             data.batchNumber is string &&
             (data.quantity is int || data.quantity is number) &&
             data.quantity >= 0 &&
             data.expiryDate is string;
    }

    // Validation for Users document schema
    // Fields: userId, role, branchId, status
    function isValidUser(data) {
      return data.userId is string &&
             data.role is string &&
             data.branchId is string &&
             (data.status == 'active' || data.status == 'inactive');
    }

    // Validation for Audit Logs document schema
    // Fields: eventId, actorId, action, recordId, timestamp, details
    function isValidAuditLog(data) {
      return data.eventId is string &&
             data.actorId is string &&
             data.action is string &&
             data.recordId is string;
    }

    // 1. Medicines Collection
    match /Medicines/{medicineId} {
      allow read: if true;
      allow create, update: if isValidMedicine(request.resource.data);
      allow delete: if isAuthenticated();
    }

    // 2. Inventory Collection
    match /Inventory/{inventoryId} {
      allow read: if true;
      allow create, update: if isValidInventory(request.resource.data);
      allow delete: if isAuthenticated();
    }

    // 3. Users Collection
    match /Users/{userId} {
      allow read: if true;
      allow create, update: if isValidUser(request.resource.data);
      allow delete: if isAuthenticated();
    }

    // 4. Audit Logs Collection (Append-only immutable event stream)
    match /AuditLogs/{eventId} {
      allow read: if true;
      allow create: if isValidAuditLog(request.resource.data);
      allow update, delete: if false; // Audit logs cannot be tampered with or modified
    }

    // 5. PharmaInventory (Backward-compatibility collection)
    match /PharmaInventory/{medicationId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if true;
    }

    // Default catch-all
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
